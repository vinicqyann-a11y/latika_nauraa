<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kopi KITA - Digital Menu</title>
</head>
<body>

  <!-- Header Banner Kafe -->
  <header class="header">
    <div class="container header-content">
      <div class="brand">
        <h1 class="brand-name">Kopi KITA ☕</h1>
        <p class="tagline">Nikmati momen bersamamu kapan saja</p>
      </div>
      <div class="table-badge">
        <span>Meja</span>
        <strong>05</strong>
      </div>
    </div>
  </header>

  <!-- Konten Utama -->
  <main class="container main-content">
    
    <!-- Area Pencarian & Filter Kategori -->
    <section class="controls-section">
      <div class="search-box">
        <input type="text" id="search-input" placeholder="Cari kopi, minum, atau snack..." aria-label="Cari Menu">
      </div>

      <div class="category-filter" id="category-filter">
        <button class="cat-btn active" data-category="all">Semua</button>
        <button class="cat-btn" data-category="coffee">Kopi</button>
        <button class="cat-btn" data-category="non-coffee">Non-Kopi</button>
        <button class="cat-btn" data-category="snack">Camilan</button>
        <button class="cat-btn" data-category="food">Makanan</button>
      </div>
    </section>

    <!-- Grid Daftar Menu -->
    <section class="menu-section">
      <div class="menu-grid" id="menu-grid">
        <!-- Kartu menu akan dirender secara dinamis oleh JavaScript -->
      </div>
    </section>

  </main>

  <!-- Sticky Bar Ringkasan Pesanan (Bottom Floating Bar) -->
  <div class="cart-bar hidden" id="cart-bar">
    <div class="cart-info">
      <span class="cart-count" id="cart-count">0 item</span>
      <span class="cart-total" id="cart-total">Total: Rp 0</span>
    </div>
    <button class="btn-checkout" id="open-cart-btn">Lihat Pesanan 🛒</button>
  </div>

  <!-- Modal Struk / Ringkasan Pesanan -->
  <div class="modal-overlay hidden" id="cart-modal">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Detail Pesanan Meja 05</h2>
        <button class="btn-close" id="close-cart-btn" aria-label="Tutup">&times;</button>
      </div>
      <div class="modal-body" id="cart-items-list">
        <!-- Item keranjang diisi via JS -->
      </div>
      <div class="modal-footer">
        <div class="summary-line">
          <span>Total Pembayaran:</span>
          <strong id="modal-total-price">Rp 0</strong>
        </div>
        <p class="modal-note">* Tunjukkan daftar ini kepada pelayan / kasir untuk mengonfirmasi pesanan.</p>
        <button class="btn-confirm" id="confirm-order-btn">Panggil Pelayan / Konfirmasi</button>
      </div>
    </div>
  </div>

</body>
</html>
